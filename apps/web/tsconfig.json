{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@geshop/ui": ["../../packages/ui/src"],
      "@geshop/ui/*": ["../../packages/ui/src/*"],
      "@geshop/db": ["../../packages/db/src"],
      "@geshop/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
