{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@geshop/ui": ["../../packages/ui/src"],
      "@geshop/ui/*": ["../../packages/ui/src/*"],
      "@geshop/db": ["../../packages/db/src"],
      "@geshop/db/*": ["../../packages/db/src/*"]
    },

    /*
     * F1 compatibility shim · alinear con tsconfig de nfq-carbon-intelligence.
     * El código trasplantado se escribió bajo `strict: true` solo (sin extras).
     * Re-activar estos flags en F2 cleanup tras pasar por todos los archivos.
     */
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitOverride": false,
    "verbatimModuleSyntax": false
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
