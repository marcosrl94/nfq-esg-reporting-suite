# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App ────────────────────────────────────────────────────────────────────
# Production: https://geshop.vercel.app o el dominio definitivo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── IA (Google Gemini) ─────────────────────────────────────────────────────
# La key vive solo en Supabase Edge Function como secret. Aquí solo el switch.
NEXT_PUBLIC_GEMINI_USE_PROXY=true

# ─── Observabilidad ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ─── Demo (solo dev local) ──────────────────────────────────────────────────
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
